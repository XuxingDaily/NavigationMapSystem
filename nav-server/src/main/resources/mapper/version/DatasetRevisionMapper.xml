<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="zhaolong.dai.nav.version.mapper.DatasetRevisionMapper">

    <select id="selectCurrent" resultType="java.lang.Long">
        SELECT revision
        FROM public.dataset_revision
        WHERE dataset_code = #{datasetCode}
    </select>

    <select id="incrementAndGet" resultType="java.lang.Long">
        SELECT public.bump_dataset_revision(#{datasetCode})
    </select>

</mapper>
